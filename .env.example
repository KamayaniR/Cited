# Cited runs in mock mode with zero keys. Fill in any group to switch that vendor to live.

# LLM (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Moss: evidence memory (sub-10 ms in-process search) and optional LLM inference
# Get both at portal.usemoss.dev
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX=cited-evidence

# Search
TAVILY_API_KEY=

# Enrichment: Hunter primary, Apollo fallback
HUNTER_API_KEY=
APOLLO_API_KEY=

# Email (always redirected to DEMO_RECIPIENT outside production)
SENDGRID_API_KEY=
SENDGRID_FROM=
DEMO_RECIPIENT=
SENDING_ENABLED=false

# Billing
FLEXPRICE_API_KEY=
FLEXPRICE_BASE_URL=https://api.cloud.flexprice.io/v1

# Multi-agent
BAND_API_KEY=
BAND_ROOM_ID=

# Graph
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Database and auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Scheduled refresh (Vercel Cron sends this as a Bearer token)
CRON_SECRET=

# Set true to force mock mode even when keys are present (recording the demo)
CITED_FORCE_MOCK=false
