# Cited runs in mock mode with zero keys. Fill in any group to switch that vendor to live.

# LLM: Meta Llama is the default (OpenAI-compatible). Moss Inference, then Claude, are fallbacks.
LLAMA_API_KEY=
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
LLAMA_BASE_URL=https://api.llama.com/compat/v1
# Claude (last fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Moss: evidence memory (sub-10 ms in-process search) and optional LLM inference
# Get both at portal.usemoss.dev
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX=cited-evidence

# Search
TAVILY_API_KEY=

# Enrichment: Hunter primary, Apollo fallback
HUNTER_API_KEY=
APOLLO_API_KEY=

# Email (always redirected to DEMO_RECIPIENT outside production)
SENDGRID_API_KEY=
SENDGRID_FROM=
DEMO_RECIPIENT=
SENDING_ENABLED=false

# Billing
FLEXPRICE_API_KEY=
FLEXPRICE_BASE_URL=https://api.cloud.flexprice.io/v1

# Multi-agent
# Band (band.ai): an agent key (band_a_...) and the room the agents work in.
# Optional per-role keys let each agent speak as itself; any role without one uses BAND_API_KEY.
BAND_API_KEY=
BAND_ROOM_ID=
BAND_PLANNER_KEY=
BAND_BUILDER_KEY=
BAND_REVIEWER_KEY=
BAND_SECURITY_KEY=
BAND_API_URL=https://app.band.ai/api/v1
# Optional: set as the agent wakeup secret so Band can ping /api/webhooks/band when a human replies
BAND_WAKEUP_SECRET=

# Graph
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Database and auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Monitoring (optional): Sentry for API errors and vendor failures, PostHog for funnel events.
# Without them errors go to the server log and funnel counts stay in memory (see /api/health).
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Scheduled refresh (Vercel Cron sends this as a Bearer token)
CRON_SECRET=

# Set true to force mock mode even when keys are present (recording the demo)
CITED_FORCE_MOCK=false
